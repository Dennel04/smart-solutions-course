# Copy to /etc/smart-solutions-lab2/env, replace every <...> placeholder,
# set owner root:root and mode 600. This file uses systemd EnvironmentFile syntax.
POST_OFFICE_USER=<WEB_USERNAME>
POST_OFFICE_PASSWORD=<GENERATE_A_LONG_RANDOM_PASSWORD>
ATOM_API_KEY=<GENERATE_A_SEPARATE_LONG_RANDOM_BEARER_KEY>
POST_OFFICE_DB=/var/lib/smart-solutions-lab2/post-office.sqlite3
JOB_TTL_SECONDS=60
JOB_MAX_TTL_SECONDS=3600
ATOM_STALE_SECONDS=10
ATOM_OFFLINE_SECONDS=30
PUBLIC_HOSTNAME=<TEAM_HOSTNAME>
